# Copy to .env.local for local development. Placeholders only: never commit real values.
# Server-only config. Do NOT prefix any of these with NEXT_PUBLIC_.

# development | test | demo | production
APP_MODE=development

# Postgres (Supabase in deploy; local throwaway via scripts/test-db.sh)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/p2p_demo

# Avalanche Fuji C-Chain
AVALANCHE_CHAIN_ID=43113
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Circle test USDC on Fuji (default)
USDC_TOKEN_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
# Allowlisted destination wallet for test-USDC settlement
DESTINATION_SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000000000

# Part 4 (settlement signer). Leave empty unless you run real settlement. 0x + 64 hex.
SETTLEMENT_PRIVATE_KEY=
# Only if part 4 runs as a separate service (>= 32 chars). Leave empty otherwise.
INTERNAL_RPC_SECRET=

QUOTE_TTL_SECONDS=300
SETTLEMENT_CONFIRMATIONS=2

# Comma-separated extra origins allowed to call mutating endpoints
# (the backend's own host is always allowed). Example: https://frontend.example.com
ALLOWED_ORIGINS=http://localhost:3000
